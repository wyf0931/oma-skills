#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
PROJECT_DIR="$SKILL_DIR/vendor/oma-docs-distill"

if ! command -v uv >/dev/null 2>&1; then
  echo "style-maker requires uv. Install it from https://docs.astral.sh/uv/" >&2
  exit 1
fi

exec uv run --project "$PROJECT_DIR" distill-agent "$@"
