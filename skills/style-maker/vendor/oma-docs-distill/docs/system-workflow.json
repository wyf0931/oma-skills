  "edges": [
    {"id": "start-detect", "from": "start", "to": "detect", "label": "input path", "variant": "emphasis"},
    {"id": "detect-fetch", "from": "detect", "to": "fetch", "label": "URL 清单", "variant": "default"},
    {"id": "detect-ready", "from": "detect", "to": "dataset_ready", "label": "Markdown 目录", "variant": "default"},
