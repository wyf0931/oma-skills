  "phases": [
    {"id": "intake", "label": "输入与数据集", "fromCol": 0, "toCol": 1},
    {"id": "distill", "label": "动态词典 + 蒸馏", "fromCol": 2, "toCol": 4, "variant": "emphasis"},
    {"id": "publish", "label": "生成与交付", "fromCol": 5, "toCol": 5, "variant": "dashed"}
  ],
  "groups": [
    {"id": "input_group", "label": "两种输入路径", "lane": "dataset", "fromCol": 0, "toCol": 1, "variant": "dashed"},
