  "cards": [
    {"dot": "cyan", "title": "已实现", "items": ["URL dataset manifest 缓存", "Jieba 动态词典", "LangGraph Send Map-Reduce", "Skill frontmatter 与协议隔离"]},
    {"dot": "rose", "title": "仍待补齐", "items": ["单次运行 checkpoint / resume", "LLM 请求级缓存与成本统计", "Skill 生成后的自动质量评分", "新旧 Skill 版本对比"]}
