    {"id": "ready-bootstrap", "from": "dataset_ready", "to": "bootstrap", "label": "candidate n-grams", "variant": "emphasis"},
    {"id": "bootstrap-map", "from": "bootstrap", "to": "map", "label": "domain dictionary", "variant": "emphasis"},
    {"id": "map-reduce", "from": "map", "to": "reduce", "label": "all map results", "variant": "emphasis"},
    {"id": "reduce-write", "from": "reduce", "to": "write", "label": "validated content", "variant": "emphasis"},
    {"id": "write-done", "from": "write", "to": "done", "label": "atomic files", "variant": "emphasis"}
