  ],
  "mainPath": ["start", "detect", "fetch", "dataset_ready", "bootstrap", "map", "reduce", "write", "done"],
  "nodes": [
    {"id": "start", "lane": "cli", "col": 0, "type": "frontend", "label": "distill-agent", "width": 142},
    {"id": "detect", "lane": "cli", "col": 1, "type": "security", "label": "识别输入", "sublabel": "目录 / URL 清单", "width": 142},
    {"id": "fetch", "lane": "dataset", "col": 1, "type": "cloud", "label": "串行 URL 采集", "sublabel": "缓存 + 重试 3 次", "width": 142},
    {"id": "dataset_ready", "lane": "dataset", "col": 2, "type": "database", "label": "Dataset Ready", "sublabel": "URL fetch / 本地 *.md", "width": 142},
    {"id": "bootstrap", "lane": "graph", "col": 3, "type": "backend", "label": "Bootstrap Lexicon", "sublabel": "N-gram → SenseNova → Jieba", "tag": "Phase 0", "width": 150},
    {"id": "map", "lane": "graph", "col": 4, "type": "messagebus", "label": "Map：逐篇蒸馏", "sublabel": "Send 并发分发", "tag": "Phase 1", "width": 142},
    {"id": "reduce", "lane": "graph", "col": 5, "type": "backend", "label": "Reduce：全局融合", "sublabel": "结构化 JSON 内容", "tag": "Phase 2", "width": 142},
    {"id": "write", "lane": "output", "col": 5, "type": "database", "label": "Skill Writer", "sublabel": "frontmatter + references", "width": 142},
    {"id": "done", "lane": "output", "col": 5, "type": "database", "label": "Skill Ready", "sublabel": "skills/<name>/", "width": 142, "yOffset": 78}
